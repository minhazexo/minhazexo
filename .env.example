# Environment Variables - copy to `.env.local`

# Database (Neon PostgreSQL) - required
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Admin JWT Secret - required (generate with: openssl rand -base64 32)
ADMIN_JWT_SECRET=your-secret-key-change-in-production

# Contact Form (Resend) - optional
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=mehrabhossain7102@gmail.com

# Site - optional
NEXT_PUBLIC_SITE_URL=https://mehrabhossain.dev

# Vercel Blob (Production image storage) - required for persistent project images on Vercel
# Create a Blob store at https://vercel.com/dashboard -> Storage -> Create Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Analytics (Google Analytics 4) - optional
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
